# Copy to .env and adjust for your environment.

# PostgreSQL + PostGIS connection (async driver for SQLAlchemy)
DATABASE_URL=postgresql+psycopg://caneiq:caneiq@localhost:5432/caneiq
# Sync URL used by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg://caneiq:caneiq@localhost:5432/caneiq

# Redis — Celery broker/result backend (NDVI ingestion, weather polling, overdue checks)
REDIS_URL=redis://localhost:6379/0

# CORS origins for the frontend (comma-separated)
CORS_ORIGINS=http://localhost:3000

# S3-compatible storage for field photos / receipts / documents
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=caneiq-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

ENVIRONMENT=development
